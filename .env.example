# ==============================================================================
# BIOT UAO - Salud Digital & Metrología Predictiva UCI (Variables de Entorno)
# Copiar este archivo a .env y ajustar credenciales antes de desplegar
# ==============================================================================

# 1. Base de Datos Relacional (PostgreSQL / Neon)
DATABASE_URL=postgresql://usuario:password@host:5432/neondb?sslmode=require
DB_HOST=app-db
DB_PORT=5432
DB_NAME=uci_telemetria
DB_USER=admin
DB_PASS=change_me_in_production

# 2. Base de Datos Documental Contable (MongoDB - R09)
MONGO_URI=mongodb://mongo:27017/uci_contabilidad
MONGO_DB_NAME=uci_contabilidad

# 3. Seguridad, Tokens de Sesión y CORS (R03)
SESSION_SECRET=change_this_to_a_256_bit_random_secret_in_production
SESSION_TTL_MINUTES=480
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://salud-digital-proyecto.onrender.com

# 4. Servicios Interoperables de Salud (R04, R06, R21)
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir
ORTHANC_PACS_URL=http://orthanc-pacs:8042
ML_SERVICE_URL=http://ml:8001

# 5. Exposición Pública Cloudflare Tunnel (R05)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
